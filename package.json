{
  "name": "labeler",
  "version": "0.0.0",
  "private": true,
  "description": "A bot to automate issue labeling",
  "scripts": {
    "build": "tsc && ncc build src/main.ts -o dist",
    "format:js": "eslint --fix src __tests__",
    "format:non-js": "prettier --write \"./**/*.{md,yml,json}\"",
    "lint:js": "eslint src __tests__",
    "lint:non-js": "prettier --check \"./**/*.{md,yml,json}\"",
    "test": "jest --verbose --colors",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@eslint/js": "9.39.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "8.58.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "jest": "30.2.0",
    "prettier": "3.0.0",
    "ts-jest": "29.4.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.32.x"
  },
  "packageManager": "pnpm@10.32.0"
}
